# Plantilla de variables para el VPS. Copiar a /opt/controasistencia/.env,
# completar con los valores REALES (los mismos que están hoy en Render) y dejarlo
# con permisos 600. Este archivo de ejemplo no lleva ningún secreto.
#
#   sudo cp env.ejemplo /opt/controasistencia/.env
#   sudo nano /opt/controasistencia/.env
#   sudo chown controasist:controasist /opt/controasistencia/.env
#   sudo chmod 600 /opt/controasistencia/.env

PORT=3001
NODE_ENV=production

# Session pooler de Supabase (NO la conexión directa: resuelve a IPv6).
DATABASE_URL=

# Dominios de Vercel separados por coma, sin espacios.
CORS_ORIGINS=https://contro-asistencia-panel.vercel.app,https://contro-asistencia.vercel.app

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

BIOMETRIC_ENC_KEY=
QR_TOKEN_TTL_SECONDS=45
LIVENESS_RETO_TTL_SECONDS=30

SUPABASE_URL=
SUPABASE_SECRET_KEY=
