{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://pizzario-controasistencia.duckdns.org/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://pizzario-controasistencia.duckdns.org/uploads/$1" },
    { "source": "/((?!api|uploads).*)", "destination": "/index.html" }
  ]
}
